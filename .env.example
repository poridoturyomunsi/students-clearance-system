# =========================================================================
# School Management System - Environment Variables Configuration Template
# Copy this file to .env in your local environment or configure these keys
# in your cloud deployment settings (Render/Railway/Vercel).
# =========================================================================

# -------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Vercel / Frontend Host)
# -------------------------------------------------------------------------
# The public HTTPS URL where your backend API server is deployed.
# Do NOT include a trailing slash.
# Example: VITE_API_URL=https://school-system-api.onrender.com
VITE_API_URL=http://localhost:3000

# -------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render / Railway / Backend Host)
# -------------------------------------------------------------------------
# Port that the server will bind to. Usually assigned dynamically by the host.
PORT=3000

# The secret key used to sign and verify JSON Web Tokens (JWT).
# Generate a long, random secure string in production (e.g. using openssl rand -base64 32).
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated list of origins permitted to access this backend (CORS configuration).
# Set this to your frontend Vercel URL in production to prevent cross-origin abuse.
# Example: ALLOWED_ORIGINS=https://my-school-system.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# -------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Railway MySQL / Managed MySQL Host)
# -------------------------------------------------------------------------
# OPTION A: Database Connection URI (Recommended for cloud hosts like Railway/PlanetScale/Aiven)
# Format: mysql://username:password@hostname:port/database_name
# Example: DATABASE_URL=mysql://root:password@containers-us-west.railway.app:3306/railway
DATABASE_URL=

# OPTION B: Individual Database Parameters (Alternative if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=school_system

# -------------------------------------------------------------------------
# 4. CLOUDINARY CONFIGURATION (Cloud Storage for Passport Photos & Signatures)
# -------------------------------------------------------------------------
# Sign up at Cloudinary.com to obtain these details.
# If these variables are not provided, the application will fallback to saving images 
# as Base64 strings directly in the database (not recommended for production).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI ASSISTANT CONFIGURATION
# -------------------------------------------------------------------------
# Obtain your free/paid key from Google AI Studio (https://aistudio.google.com).
# Can also be configured directly via the Admin Settings UI inside the app.
GEMINI_API_KEY=your_google_gemini_api_key_here

# -------------------------------------------------------------------------
# 6. TWILIO WHATSAPP NOTIFICATION CONFIGURATION
# -------------------------------------------------------------------------
# Set these variables to enable sending real WhatsApp notifications.
# Leave blank to fallback to simulated/mock delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

