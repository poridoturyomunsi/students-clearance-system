{
  "name": "students-clearance-cards",
  "version": "1.0.0",
  "description": "Students Clearance Cards System",
  "author": "Turyomunsi Porido",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "build": "vite build",
    "server": "node electron/server.js",
    "electron:dev": "node scripts/electron-dev.js",
    "electron:build": "npm run build && electron-builder",
    "validate-deploy": "node scripts/validate-deployment.js"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.13.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.0.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.clearance.printer",
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Students Clearance Cards"
    },
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "icon.ico"
    ]
  }
}
